APP_ENV=local
APP_BASE_URL=http://localhost:3000
WORDPRESS_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/omdivyadarshan?schema=public
SESSION_SECRET=replace-with-a-long-random-local-secret
# Restricts primary navigation to the locked Phase-1 client-UAT surfaces.
PHASE1_UAT_MODE=false
RAZORPAY_MODE=test
PAYPAL_MODE=sandbox
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=gcs. Authentication uses Google Application Default Credentials.
# Attach a user-managed service identity in hosted environments. For local UAT, use short-lived
# service-account impersonation. Do not create or configure a service-account JSON key.
GCS_PROJECT_ID=replace-with-gcp-project-id
GCS_PRIVATE_BUCKET=replace-with-private-kundli-report-bucket
KUNDLI_REPORT_SIGNED_URL_TTL_SECONDS=600
WALLET_ENABLED=false
WALLET_MODE=mock
