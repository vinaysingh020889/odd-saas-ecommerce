APP_ENV=staging
APP_BASE_URL=https://replace-with-temporary-uat-domain.example
WORDPRESS_BASE_URL=https://replace-with-wordpress-domain.example
ASTHI_APPLICATION_URL=
DATABASE_URL=
SESSION_SECRET=
PHASE1_UAT_MODE=true
RAZORPAY_MODE=test
PAYPAL_MODE=sandbox
STORAGE_DRIVER=gcs
GCS_PROJECT_ID=
GCS_PRIVATE_BUCKET=
KUNDLI_REPORT_SIGNED_URL_TTL_SECONDS=600
WALLET_ENABLED=false
WALLET_MODE=mock

# One-time synthetic UAT provisioning only. Keep false during normal operation.
# Set a unique secret out-of-band, enable only for the seed command, then disable.
ALLOW_SYNTHETIC_SEED=false
SYNTHETIC_UAT_PASSWORD=
